}
package "api.classes.bsp.BSPNodeRoom" as api.classes.bsp.BSPNodeRoom {
}
package "api.classes.settings" as api.classes.settings {
}
package "api.main" as api.main {
}
api.main --> api.classes.Grid
api.main --> api.classes.LevelPostProcessor
api.main --> api.classes.bsp.BSPLevelGenerator
@enduml
