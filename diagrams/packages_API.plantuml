@startuml packages_API
set namespaceSeparator none
package "api" as api {
}
package "api.classes" as api.classes {
}
package "api.classes.Grid" as api.classes.Grid {
}
package "api.classes.LevelPostProcessor" as api.classes.LevelPostProcessor {
}
package "api.classes.bsp" as api.classes.bsp {
}
