@startuml usecase
actor Player

rectangle "Lucky You Game System" {
  usecase "Start Game" as UC1
  usecase "Navigate Menu" as UC2
  usecase "Customize Settings" as UC3
  usecase "Play Level" as UC4
  usecase "Collect Key" as UC5
  usecase "Reach Exit" as UC6
  usecase "View Game Over Screen" as UC7
  usecase "Generate Level via API" as UC8
}

Player --> UC2
UC2 --> UC1 : <<include>>
UC2 --> UC3 : <<include>>
UC1 --> UC4
UC4 --> UC5 : <<include>>
UC4 --> UC6 : <<include>>
UC4 --> UC7 : <<extend>>
UC4 --> UC8 : <<include>>
UC6 --> UC7 : <<extend>>
Player --> UC3

@enduml
